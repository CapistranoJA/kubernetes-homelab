tenno-cluster:
  nodes:
    controllers:
      hosts:
%{for name, node in k8s_nodes ~}
%{if node.role == "controller" ~}
        ${name}:
          ansible_host: ${split("/", node.ip)[0]}
%{endif ~}
%{endfor ~}
    workers:
      hosts:
%{for name, node in k8s_nodes ~}
%{if node.role == "worker" ~}
        ${name}:
          ansible_host: ${split("/", node.ip)[0]}
%{endif ~}
%{endfor ~}
  vars:
    ansible_ssh_private_key_file: ${ssh_key}
    ansible_host: ubuntu  